      "text": "[..]\n<sound>\n <play>\n  <other-play \n   type=\"tuning-ableton\">\n    <![CDATA[\n! blackwood_15.ascl\n15-EDO with Easley Blackwood's Ups and\nDowns Notation adapted for MusicXML.\n!\n15\n!\n80. 160. 240. 320. 400.\n480. 560. 640. 720. 800.\n880. 960. 1040. 1120. 1200.\n! @ABL NOTE_NAMES \nB/C \nCnatural-up/Dflat-up \nCsharp-down/Dnatural-down D/Eflat \nDnatural-up/Eflat-up \nDsharp-down/Enatural-down \nE/F \nFnatural-up/Gflat-up \nFsharp-down/Gnatural-down G/Aflat \nGnatural-up/Aflat-up \nGsharp-down/Anatural-down \nA/Bflat \nAnatural-up/Bflat-up \nAsharp-down/Bnatural-down\n! @ABL REFERENCE_PITCH 4 0 261.6256",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[..]\n<sound>\n <play>\n  <other-play \n   type=\"tuning-ableton\">\n    <![CDATA[\n! blackwood_15.ascl\n15-EDO with Easley Blackwood's Ups and Downs Notation adapted for MusicXML.\n!\n15\n!\n80. 160. 240. 320. 400.\n480. 560. 640. 720. 800.\n880. 960. 1040. 1120. 1200.\n! @ABL NOTE_NAMES \nB/C \nCnatural-up/Dflat-up \nCsharp-down/Dnatural-down D/Eflat \nDnatural-up/Eflat-up \nDsharp-down/Enatural-down \nE/F \nFnatural-up/Gflat-up \nFsharp-down/Gnatural-down G/Aflat \nGnatural-up/Aflat-up \nGsharp-down/Anatural-down \nA/Bflat \nAnatural-up/Bflat-up \nAsharp-down/Bnatural-down\n! @ABL REFERENCE_PITCH 4 0 261.6256",
      "autoResize": false,
      "lineHeight": 1.25
    },
